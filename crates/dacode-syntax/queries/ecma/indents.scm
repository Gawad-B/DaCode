; Shared by JavaScript and TypeScript: only nodes both grammars have, or the TypeScript query
; would refuse to compile.
[
  (statement_block)
  (class_body)
  (switch_body)
  (switch_case)
  (switch_default)
  (object)
  (object_pattern)
  (array)
  (array_pattern)
  (arguments)
  (formal_parameters)
  (named_imports)
  (export_clause)
  (template_substitution)
  (parenthesized_expression)
  (lexical_declaration)
  (variable_declaration)
] @indent

[ "}" ")" "]" ] @outdent
